{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Panopus",
  "version": "0.2.3",
  "identifier": "ch.panopus.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Panopus",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; font-src 'self' asset: http://asset.localhost data:; frame-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://api.frankfurter.app",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Documents/GitHub/panopus-library/**",
          "$HOME/Library/Fonts/**",
          "/Library/Fonts/**",
          "/System/Library/Fonts/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBQjVDMEM0MUQyMzJFMDAKUldRQUxpTWR4TUMxcXZZaWY5MkptUm1MSjVOUVVxWVUvZWN6WTRuWjN3WjB0QnZQV2RYbVJJZGUK",
      "endpoints": [
        "https://github.com/lorisbriguet/Panopus/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  }
}